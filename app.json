{
  "expo": {
    "name": "Van Switches",
    "slug": "van-switches",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vdawger.vanswitches",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-bg.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#FFB52E"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "package": "com.vdawger.vanswitches"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Allow Van Switches to use Bluetooth to find and control the van's relay boards.",
          "neverForLocation": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "sdkVersion": "52.0.0",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "460f4bde-1ec7-48a0-8b2b-6cc9f6bbaa5c"
      }
    },
    "owner": "vdawger"
  },
  "name": "vancontrolapp"
}
